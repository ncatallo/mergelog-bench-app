server {
    listen 80;
    root /usr/share/nginx/html;

    # runtime config: the same image works behind any platform, only env vars change
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control no-store;
        return 200 "window.BENCH = { api: '${API_URL}', platform: '${DEPLOYED_WITH}' };";
    }

    location / {
        try_files $uri /index.html;
    }
}
